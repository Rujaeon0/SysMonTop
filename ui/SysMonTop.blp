using Gtk 4.0;

ApplicationWindow main_window {
  Box {
    orientation: vertical;

    Box top_stats_row {
      orientation: horizontal;
      hexpand: true;
      margin-top: 14;
      margin-bottom: 16;
      margin-start: 24;
      margin-end: 24;
      spacing: 0;

      Box {
        orientation: vertical;
        hexpand: true;
        spacing: 6;

        Label {
          label: "CPU";
          halign: start;

          styles ["secondary-label"]
        }

        Label cpu_usage_loading {
          label: "Loading...";
          halign: start;

          styles ["stat-value"]
        }

        LevelBar cpu_usage_bar {
          min-value: 0;
          max-value: 100;
          value: 0;
          hexpand: true;
        }
      }

      Separator {
        orientation: vertical;
        margin-start: 20;
        margin-end: 20;
      }

      Box {
        orientation: vertical;
        hexpand: true;
        spacing: 6;

        Label {
          label: "Memory";
          halign: start;

          styles ["secondary-label"]
        }

        Label total_ram_loading {
          label: "Loading...";
          halign: start;

          styles ["stat-value"]
        }

        Label availble_ram_loading {
          label: "Loading...";
          halign: start;

          styles ["secondary-label"]
        }

        LevelBar memory_usage_bar {
          min-value: 0;
          max-value: 100;
          value: 0;
          hexpand: true;
        }
      }

      Separator {
        orientation: vertical;
        margin-start: 20;
        margin-end: 20;
      }

      Box {
        orientation: vertical;
        hexpand: true;
        spacing: 6;

        Label {
          label: "Swap";
          halign: start;

          styles ["secondary-label"]
        }

        Label virt_mem_loading {
          label: "Loading...";
          halign: start;

          styles ["stat-value"]
        }

        Label avai_virt_mem_loading {
          label: "Loading...";
          halign: start;

          styles ["secondary-label"]
        }

        LevelBar swap_usage_bar {
          min-value: 0;
          max-value: 100;
          value: 0;
          hexpand: true;
        }
      }
    }

    Separator {
      styles ["hairline"]
    }

    Paned columns {
      ScrolledWindow network {
        Box {
          orientation: vertical;
          spacing: 6;

          Label {
            label: "Storage Usage";
            halign: start;
            margin-start: 6;
            margin-top: 6;

            styles ["panel-title"]
          }

          DropDown storage_selector {
            margin-start: 6;
            margin-end: 6;
            halign: start;
          }

          DrawingArea storage_graph {
            height-request: 110;
            hexpand: true;
            margin-start: 6;
            margin-end: 6;
          }

          Label {
            label: "Memory Usage";
            halign: start;
            margin-start: 6;

            styles ["panel-title"]
          }

          DrawingArea memory_graph {
            height-request: 110;
            hexpand: true;
            margin-start: 6;
            margin-end: 6;
          }

          Separator {
            margin-top: 6;
            margin-bottom: 6;
          }

          ColumnView network_view {
            vexpand: true;
          }

          Label {
            label: "Network Usage";
            halign: start;
            margin-start: 6;
            margin-top: 6;

            styles ["panel-title"]
          }

          DrawingArea network_graph {
            height-request: 110;
            hexpand: true;
            margin-start: 6;
            margin-end: 6;
            margin-bottom: 6;
          }
        }
      }

      Paned inner {
        ScrolledWindow process_scroll {
          hexpand: true;
          vexpand: true;

          ColumnView pid_view_loading {
            hexpand: true;
            vexpand: true;
          }
        }

        Box process_details_panel {
          orientation: vertical;
          hexpand: true;
          vexpand: true;

          Box detail_upper {
            orientation: vertical;
            spacing: 8;
            margin-top: 10;
            margin-start: 10;
            margin-end: 10;

            Label {
              label: "Process Details";
              halign: start;

              styles ["title-4"]
            }

            Separator {
              margin-bottom: 6;
            }

            Stack detail_stack {
              visible-child-name: "empty";
              vhomogeneous: false;

              StackPage {
                name: "empty";

                child: Box {
                  orientation: vertical;
                  valign: center;
                  margin-top: 30;

                  Label {
                    label: "Double-click a process to inspect it";
                    halign: center;
                    wrap: true;

                    styles ["secondary-label"]
                  }
                };
              }

              StackPage {
                name: "details";

                child: Box {
                  orientation: vertical;
                  spacing: 8;

                  Label detail_pid_label {
                    halign: start;
                    label: "PID: —";

                    styles ["data-value"]
                  }

                  Label detail_name_label {
                    halign: start;
                    label: "Name: —";
                  }

                  Label detail_ram_label {
                    halign: start;
                    label: "RAM: —";

                    styles ["data-value"]
                  }

                  Label detail_cpu_label {
                    halign: start;
                    label: "CPU: —";

                    styles ["data-value"]
                  }

                  Box {
                    orientation: horizontal;
                    spacing: 8;
                    margin-top: 10;

                    Button kill_button {
                      label: "Terminate";
                    }

                    Button force_kill_button {
                      label: "Force Kill";

                      styles ["destructive-action"]
                    }
                  }

                  Label detail_status_label {
                    halign: start;
                    margin-top: 6;
                    label: "";

                    styles ["secondary-label"]
                  }
                };
              }
            }

            Separator {
              margin-top: 10;
              margin-bottom: 4;
            }

            Box {
              orientation: horizontal;
              spacing: 8;

              Label {
                label: "Uptime";
                halign: start;
                hexpand: true;

                styles ["secondary-label"]
              }

              Label overview_uptime_label {
                label: "—";
                halign: end;

                styles ["data-value"]
              }
            }
          }

          Box detail_lower {
            vexpand: true;
          }
        }
      }
    }
  }
}